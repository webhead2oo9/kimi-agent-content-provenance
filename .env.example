# Append content_provenance to the instance's existing KIMI_MODULES list.
KIMI_MODULES=content_provenance
# Optional: allow the bot to start if this module cannot start.
KIMI_OPTIONAL_MODULES=content_provenance
CONTENT_PROVENANCE_OPENAI_API_KEY=
# Default 10 MiB; maximum 50 MiB.
CONTENT_PROVENANCE_MAX_FILE_BYTES=10485760
CONTENT_PROVENANCE_TIMEOUT_SECONDS=60
